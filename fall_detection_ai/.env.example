# Backend configuration - copy to .env and edit
# Database URL - default SQLite, can switch to PostgreSQL
DATABASE_URL=sqlite:///./fall_detection.db

# Server
HOST=0.0.0.0
PORT=8000

# Models
# Path to trained YOLO weights
# Default: runs/detect/train/weights/best.pt (auto-detected)
# Or set absolute path:
# TRAINED_MODEL_PATH=/path/to/best.pt

# Detection
PERSON_CONF_THRESHOLD=0.4
POSE_CONF_THRESHOLD=0.3

# Fall detection
FALL_WINDOW_SECONDS=1.5
FALL_PROB_THRESHOLD=0.65
ALERT_CONFIRM_FRAMES=3

# Camera
WEBCAM_INDEX=0